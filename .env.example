# Gemini proof parser
GEMINI_API_KEY=AQ.Adk8cD4p3oZcp-aX85g
GEMINI_MODEL=gemini-3.5-flash-lite

# Discord proof ingestion - use a bot token, not a normal user token
DISCORD_BOT_TOKEN=MTU0Ma9CE7BddMFGqfKR_U
PROOF_CHANNEL_ID=1543375057231814668
# Optional: only this Discord user may use the proof context-menu command.
DISCORD_SUBMITTER_USER_ID=
# Use a number for recent messages or "all" for the full channel history.
PROOF_BACKFILL_LIMIT=5
PROOF_PARSER_COOLDOWN=2
PROOF_QUEUE_SIZE=25
PROOF_MAX_ATTEMPTS=3
PROOF_PROCESSING_TIMEOUT_SECONDS=600
# Increment when prompt/schema semantics change and old proofs must be reparsed.
PROOF_PARSER_VERSION=5
PROOF_MAX_IMAGES=4
PROOF_MAX_IMAGE_BYTES=5242880
PROOF_MAX_TOTAL_IMAGE_BYTES=15728640

# SQLite + automation controls. Automation starts fully paused on first run.
DATABASE_PATH=data/trader.db
# Set this before exposing the Flask API outside localhost.
AUTOMATION_CONTROL_TOKEN=

# Roblox legacy trade API. Treat the security cookie like a password.
ROBLOX_SECURITY_COOKIE=
ROBLOX_USER_ID=
# Preferred user-inventory backend. Create a Roblox Open Cloud API key with
# inventory read access; owner pages still use the legacy Roblox endpoint.
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_OPEN_CLOUD_INVENTORY_ENABLED=true

# Public-inventory trade inference
INVENTORY_POLL_INTERVAL_SECONDS=300
# Persistent watched-user queue: only the oldest/highest-priority due users
# are polled each cycle, with spacing to prevent inventory request bursts.
WATCHED_USER_POLL_BUDGET=5
WATCHED_USER_REQUEST_DELAY_SECONDS=10
WATCHED_USER_POLL_INTERVAL_SECONDS=1800
WATCHED_USER_FAILURE_RETRY_SECONDS=3600
# Trade-ad advertiser lifecycle. Records are retained permanently; only polling
# is disabled after 365 inactive days, and a new ad re-enables the user.
TRADE_AD_HOT_WINDOW_SECONDS=21600
TRADE_AD_HOT_POLL_SECONDS=21600
TRADE_AD_WARM_WINDOW_SECONDS=259200
TRADE_AD_WARM_POLL_SECONDS=43200
TRADE_AD_ACTIVE_WINDOW_SECONDS=2592000
TRADE_AD_ACTIVE_POLL_SECONDS=86400
TRADE_AD_COLD_POLL_SECONDS=604800
TRADE_AD_ARCHIVE_AFTER_DAYS=365
# Permissioned Rolimon's recent trade-ad feed. The endpoint covers roughly the
# previous three minutes, so 30 seconds leaves ample overlap for deduplication.
ROLIMONS_TRADE_AD_POLL_SECONDS=30
ROLIMONS_TRADE_AD_REPROMOTE_SECONDS=1800
ROLIMONS_TRADE_AD_ASSET_PRIORITY_SECONDS=21600
ROLIMONS_TRADE_AD_ERROR_RETRY_SECONDS=120
# Store every ad, but inventory-poll only a bounded cohort of repeat advertisers
# or users offering a sufficiently valuable item. Only repeatedly offered items
# consume the trade-ad asset-priority lane.
ROLIMONS_TRADE_AD_ADMISSION_WINDOW_SECONDS=86400
ROLIMONS_TRADE_AD_ADMISSION_MIN_ADS=3
ROLIMONS_TRADE_AD_ADMISSION_MIN_OFFER_VALUE=100000
ROLIMONS_TRADE_AD_ADMISSION_MAX_USERS=500
ROLIMONS_TRADE_AD_ASSET_MIN_OFFERS=3
ROLIMONS_TRADE_AD_MAX_PRIORITY_ASSETS=200
INFERRED_TRADE_WINDOW_SECONDS=21600
INVENTORY_REQUEST_TIMEOUT=15
OWNER_SWEEP_PAGE_BUDGET=10
# Priority assets come from proofs and observed transfers; background pages
# round-robin through untouched/oldest catalog assets without starvation.
OWNER_SWEEP_PRIORITY_PAGE_BUDGET=6
OWNER_SWEEP_BACKGROUND_PAGE_BUDGET=1
OWNER_SWEEP_PAGE_ROTATION_SECONDS=60
OWNER_SWEEP_HIDDEN_PAGE_THRESHOLD=20
OWNER_SWEEP_HIDDEN_RETRY_SECONDS=86400
# Delay between Roblox owner-page requests. Increase this if 429s persist.
OWNER_SWEEP_REQUEST_DELAY_SECONDS=5
OWNER_SWEEP_HIGH_VALUE_INTERVAL_SECONDS=600
OWNER_SWEEP_NORMAL_INTERVAL_SECONDS=3600
# Scheduling assumptions; Roblox remains authoritative about actual eligibility.
TRADE_HOLD_DAYS=3
SALE_HOLD_DAYS=7
# Proof/inferred-trade linking and learned valuation safeguards.
PROOF_TRADE_LINK_WINDOW_DAYS=7
LEARNED_VALUE_MIN_PROOFS=3
LEARNED_VALUE_MAX_AGE_DAYS=90
# Proofs are voluntarily posted showcase trades, so their deviation from the
# baseline is partially shrunk when estimating a typical executable price.
LEARNED_VALUE_RECENCY_HALF_LIFE_DAYS=14
LEARNED_VALUE_PROOF_EXECUTABILITY_WEIGHT=0.50
LEARNED_VALUE_VERIFIED_EXECUTABILITY_WEIGHT=0.85
# Assigned-value RAP guard. Applied only with demand >= Normal and a
# Lowering/Stable/Raising trend; unstable and unassigned items are ignored.
RAP_VALUE_BAD_RATIO=0.83
RAP_VALUE_DECENT_RATIO=0.90
RAP_VALUE_GOOD_RATIO=0.95
RAP_VALUE_RAISING_RATIO=0.97
RAP_VALUE_BAD_MULTIPLIER=0.90
RAP_VALUE_DECENT_MULTIPLIER=0.95
RAP_VALUE_GOOD_MULTIPLIER=0.98
RAP_VALUE_LOWERING_EXTRA_PENALTY=0.02
RAP_VALUE_RAISING_MAX_BONUS=0.02
